    \u0434\u0440\u0430\u043A\u043E\u043D \u0410\u0436\u0434\u0430\u0445\u0430. \u0415\u0433\u043E
    \u0433\u043D\u0435\u0432 \u0441\u043E\u0442\u0440\u044F\u0441 \u0441\u043A\u0430\u043B\u044B,
    \u0430 \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u0432\u044B\u0436\u0433\u043B\u043E
    \u043D\u0435\u0431\u0435\u0441\u0430."
