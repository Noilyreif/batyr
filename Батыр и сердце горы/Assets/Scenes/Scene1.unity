  m_text: "\u0412 \u0442\u0435\u043D\u0438 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
    \u0423\u0440\u0430\u043B\u044C\u0441\u043A\u0438\u0445 \u0433\u043E\u0440, \u0441\u0440\u0435\u0434\u0438
    \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u0445 \u0441\u0442\u0435\u043F\u0435\u0439,
    \u0436\u0438\u043B\u0430 \u043C\u0438\u0440\u043D\u0430\u044F \u0431\u0430\u0448\u043A\u0438\u0440\u0441\u043A\u0430\u044F
    \u0434\u0435\u0440\u0435\u0432\u043D\u044F. \u041B\u044E\u0434\u0438 \u043F\u0430\u0441\u043B\u0438
    \u0441\u043A\u043E\u0442, \u0440\u0430\u0441\u0442\u0438\u043B\u0438 \u0434\u0435\u0442\u0435\u0439
    \u0438 \u0441\u043B\u0430\u0432\u0438\u043B\u0438 \u0449\u0435\u0434\u0440\u0443\u044E
    \u0437\u0435\u043C\u043B\u044E, \u0430 \u0447\u0438\u0441\u0442\u044B\u0435 \u0440\u043E\u0434\u043D\u0438\u043A\u0438
    \u0434\u0430\u0432\u0430\u043B\u0438 \u0438\u043C \u0441\u0438\u043B\u044B."
